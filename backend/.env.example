# ──────────────────────────────────────────────
# Caption Roulette — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ─────────────────
# Full JDBC connection string from your Neon project dashboard
# Format: jdbc:postgresql://<host>/<dbname>?sslmode=require&channel_binding=require
NEON_DB_URL=jdbc:postgresql://<neon-host>/<dbname>?sslmode=require&channel_binding=require
NEON_DB_USER=<neon-db-username>
NEON_DB_PASSWORD=<neon-db-password>

# ── JWT ────────────────────────────────────────
# Must be at least 32 random characters — used to sign tokens
# Generate one: openssl rand -base64 48
JWT_SECRET=<min-32-char-random-string>

# ── AWS ────────────────────────────────────────
# IAM user credentials — needs S3 read/write + SQS send permissions
AWS_ACCESS_KEY=<iam-access-key-id>
AWS_SECRET_KEY=<iam-secret-access-key>
# Region where your CDK stacks are deployed (e.g. us-east-1, ap-south-2)
AWS_REGION=us-east-1
# S3 bucket name from the StorageStack CDK output
S3_BUCKET=<your-s3-bucket-name>

# ── Redis (Upstash) ────────────────────────────
# Full Upstash Redis connection URL (rediss:// for TLS)
# Found in: Upstash Console → Your Database → Details → Connection String
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
