# ──────────────────────────────────────────────
# Caption Roulette — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────

# ── API ────────────────────────────────────────
# Base URL of the Spring Boot backend (no trailing slash)
# Local development: http://localhost:8080
# Production:        https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# ── AWS CloudFront CDN ─────────────────────────
# CloudFront distribution domain from the StorageStack CDK output
# Used to build image URLs for processed WebP images & thumbnails
# Format: https://<distribution-id>.cloudfront.net  (no trailing slash)
VITE_S3_BASE_URL=https://<distribution-id>.cloudfront.net
